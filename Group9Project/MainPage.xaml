<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Group9Project.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:GoalTracker.Models"
    xmlns:vm="clr-namespace:GoalTracker.ViewModels"
    x:DataType="vm:GoalViewModel"
    Title="Goals">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="12">
            <Label
                FontAttributes="Bold"
                FontSize="28"
                Text="My goals" />
            <Entry
                Placeholder="Goal title"
                Text="{Binding Title}" />
            <Editor
                AutoSize="TextChanges"
                MinimumHeightRequest="72"
                Placeholder="Description"
                Text="{Binding Description}" />
            <HorizontalStackLayout Spacing="8">
                <Button
                    Text="Add goal"
                    Command="{Binding AddGoalCommand}">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsEditing}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Text="Save changes"
                    Command="{Binding UpdateGoalCommand}"
                    IsVisible="False">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsEditing}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Text="Cancel"
                    Command="{Binding CancelEditCommand}"
                    IsVisible="False">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsEditing}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Label
            Grid.Row="1"
            FontAttributes="Bold"
            FontSize="20"
            Text="Your list" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Goals}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label
                    Margin="0,20"
                    HorizontalOptions="Center"
                    Text="No goals yet. Add one above to get started." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Goal">
                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        Stroke="{StaticResource Gray300}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Title}" />
                                <Label
                                    FontSize="14"
                                    Text="{Binding Description}"
                                    TextColor="{StaticResource Gray600}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Padding="10,4"
                                Text="Edit"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalViewModel}}, Path=EditCommand}"
                                CommandParameter="{Binding}" />
                            <Button
                                Grid.Column="2"
                                Padding="10,4"
                                Text="Delete"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalViewModel}}, Path=DeleteGoalCommand}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
